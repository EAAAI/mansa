## 2. Update Student Viewers (The "Readers")
We will replace direct Firestore fetches with `fetchWithCache` in 4 files.

### A. `src/js/features/subjects-catalog.js`
Inside `loadSubjectsCatalog()`:
```javascript
import { fetchWithCache } from '../utils/cache-manager.js';

export async function loadSubjectsCatalog() {
    const db = firebase.firestore();
    return fetchWithCache(db, 'mansa_subjects_catalog', 'subjectsCatalog', async () => {
        const snapshot = await db.collection(SUBJECTS_COLLECTION).orderBy('order').get();
        const subjects = [];
        snapshot.forEach(doc => {
            if (doc.data().isActive !== false) subjects.push({ id: doc.id, ...doc.data() });
        });
        return subjects;
    });
}
```

### B. `src/js/features/roadmap-viewer.js`
Inside `fetchRoadmapBlocks(subjectId, db)`:
```javascript
import { fetchWithCache } from '../utils/cache-manager.js';

async function fetchRoadmapBlocks(subjectId, db) {
    if (!db || !subjectId) return [];
    
    return fetchWithCache(db, `mansa_roadmap_${subjectId}`, `roadmap_${subjectId}`, async () => {
        // ... existing snapshot logic returning blocks ...
    });
}
```

### C. `src/js/features/questions-viewer.js`
Inside `fetchQuestions(subjectId, db)`:
```javascript
import { fetchWithCache } from '../utils/cache-manager.js';
// wrap existing logic
```

### D. `src/js/features/summaries-viewer.js`
