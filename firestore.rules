rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subject_pages/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_submissions/{submissionId} {
      allow read, write: if isAdmin();
    }

    // Roadmap blocks — public read so any student can load the learning path.
    // Write is restricted to admins who manage content via the dashboard.
    match /roadmap_blocks/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions — public read, admin write.
    match /subject_questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Summaries — public read, admin write.
    match /subject_summaries/{summaryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}